<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Colors.Dark.xaml defines the same keys; reference them with DynamicResource so switching applies live. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#FAFAF7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HoverBrush" Color="#F0EFEA" />
    <SolidColorBrush x:Key="LineBrush" Color="#E3E1DA" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2328" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B6F76" />
    <!-- Note IDs: present but barely there -->
    <SolidColorBrush x:Key="FaintBrush" Color="#B4B7BC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FDF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F0FD" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#C62828" />
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#F3F2EE" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#CFCDC6" />
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#2F6FDF" Opacity="0.25" />

    <!-- Editor syntax colors (applied to the AvalonEdit highlighting in code) -->
    <SolidColorBrush x:Key="SyntaxHeadingBrush" Color="#1F4E79" />
    <SolidColorBrush x:Key="SyntaxCodeBrush" Color="#8A3B12" />
    <SolidColorBrush x:Key="SyntaxListBrush" Color="#9A6700" />
</ResourceDictionary>
