<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette: same keys as Colors.Light.xaml. Warm-neutral greys, accent lifted for contrast on dark. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#1B1D21" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#222529" />
    <SolidColorBrush x:Key="HoverBrush" Color="#2C3036" />
    <SolidColorBrush x:Key="LineBrush" Color="#363A41" />
    <SolidColorBrush x:Key="TextBrush" Color="#E3E5E8" />
    <SolidColorBrush x:Key="MutedBrush" Color="#9BA1A9" />
    <SolidColorBrush x:Key="FaintBrush" Color="#5E646C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6FA3FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#25344D" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F2766F" />
    <SolidColorBrush x:Key="CodeBackgroundBrush" Color="#2B2F35" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#474C54" />
    <SolidColorBrush x:Key="TextSelectionBrush" Color="#6FA3FF" Opacity="0.30" />

    <SolidColorBrush x:Key="SyntaxHeadingBrush" Color="#8DBAF2" />
    <SolidColorBrush x:Key="SyntaxCodeBrush" Color="#E5A675" />
    <SolidColorBrush x:Key="SyntaxListBrush" Color="#D9AE4A" />
</ResourceDictionary>
